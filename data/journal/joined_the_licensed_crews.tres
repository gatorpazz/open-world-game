[gd_resource type="Resource" script_class="JournalEntryDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/journal_entry_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"joined_the_licensed_crews"
lore_sources = Array[StringName]([&"wester", &"licensed_crews", &"suddel"])
text = "Wester counted me in — a share in the Longswathe, witnessed at Suddel's counter, entered in the licensed book. The sky prices every crew but me; now that arithmetic works for the Longswathe."
