[gd_resource type="Resource" script_class="JournalEntryDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/journal_entry_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"the_chalk_by_the_gate"
lore_sources = Array[StringName]([&"the_untaken_arrival", &"lastdoor"])
text = "Chalk on the walls near the Last Gate: nine strokes, a tenth crossed through — fresh in places, rubbed and redrawn in others. It began appearing after I was found. Nobody will explain it to the one it refers to."
