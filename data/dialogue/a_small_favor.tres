[gd_resource type="Resource" script_class="DialogueTopicDef" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue_topic_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/dialogue_response.gd" id="2"]
[ext_resource type="Script" path="res://scripts/resources/item_stack.gd" id="3"]
[ext_resource type="Resource" path="res://data/items/rat_pelt.tres" id="4"]
[ext_resource type="Resource" path="res://data/items/healing_draught.tres" id="5"]

[sub_resource type="Resource" id="take_pelt"]
script = ExtResource("3")
item = ExtResource("4")
count = 1

[sub_resource type="Resource" id="give_draught"]
script = ExtResource("3")
item = ExtResource("5")
count = 1

[sub_resource type="Resource" id="resp_suddel"]
script = ExtResource("2")
npc_id = &"suddel"
take_items = Array[ExtResource("3")]([SubResource("take_pelt")])
text = "One pelt, posted bounty, entered. Here — a draught from stores for your trouble. Counted and kept — and the book doesn't forget a favor."
journal_entry = &"suddels_stores_favor"
give_items = Array[ExtResource("3")]([SubResource("give_draught")])

[sub_resource type="Resource" id="resp_suddel_done"]
script = ExtResource("2")
npc_id = &"suddel"
requires_journal = Array[StringName]([&"suddels_stores_favor"])
text = "The book holds your line, and the book doesn't forget. Bring more pelts if the rats oblige — posted bounty, same as ever."

[sub_resource type="Resource" id="resp_suddel_no_pelt"]
script = ExtResource("2")
npc_id = &"suddel"
text = "Got that pelt for me yet? The vault rats wear them, if you take my meaning. Come back when you have one."
journal_entry = &"suddel_wants_a_pelt"

[resource]
script = ExtResource("1")
id = &"a_small_favor"
display_name = "a small favor"
responses = Array[ExtResource("2")]([SubResource("resp_suddel"), SubResource("resp_suddel_done"), SubResource("resp_suddel_no_pelt")])
