[ext_resource type="Script" path="res://scripts/resources/ingredient_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"terrace_fungus"
display_name = "Terrace Fungus"
description = "A knuckle of the bright fungus grown on Embershare's terraces — the island's food and its medicine both, and the base of every simple Tansy sells."
weight = 0.1
base_value = 4
stackable = true
max_stack = 20
effects = Array[StringName]([&"restore_health", &"restore_stamina"])
