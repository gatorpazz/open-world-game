[gd_resource type="Resource" script_class="QuestDef" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/quest_stage.gd" id="2"]

[sub_resource type="Resource" id="stage_woke"]
script = ExtResource("2")
journal_entry = &"woke_in_the_bait_square"

[sub_resource type="Resource" id="stage_request"]
