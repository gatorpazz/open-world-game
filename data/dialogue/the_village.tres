[gd_resource type="Resource" script_class="DialogueTopicDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue_topic_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/dialogue_response.gd" id="2"]

[sub_resource type="Resource" id="resp_hunald"]
script = ExtResource("2")
npc_id = &"hunald"
text = "Forty souls, give or take, most of them stubborn. It was bigger once — before folk started shunning [[the_old_barrow|the old barrow]] and the road that runs past it."

[sub_resource type="Resource" id="resp_fallback"]
script = ExtResource("2")
text = "A quiet place. We keep the causeway planked and mind our own. The old folk could tell you about [[the_old_barrow]], though they'd rather not."

[resource]
script = ExtResource("1")
id = &"the_village"
display_name = "the village"
responses = Array[ExtResource("2")]([SubResource("resp_hunald"), SubResource("resp_fallback")])
