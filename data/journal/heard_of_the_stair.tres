[gd_resource type="Resource" script_class="JournalEntryDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/journal_entry_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"heard_of_the_stair"
lore_sources = Array[StringName]([&"drowned_stair"])
text = "I have heard talk of old stairs at the bottom of the Scar, going down to a gate nobody opens. The town gives the lower flights a wide berth, and nobody will say quite why."
