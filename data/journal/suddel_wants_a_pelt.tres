[gd_resource type="Resource" script_class="JournalEntryDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/journal_entry_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"suddel_wants_a_pelt"
text = "Suddel, the quartermaster at Lastdoor's warehouse row, wants a vault-rat pelt for his bounty book. He pays from crew stores — a draught for a pelt, the line entered in my presence."
