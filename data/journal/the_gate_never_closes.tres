[ext_resource type="Script" path="res://scripts/resources/journal_entry_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"the_gate_never_closes"
lore_sources = Array[StringName]([&"lastdoor"])
text = "The Last Gate stands chitin-plated, counterweighted, and never fully closed. I asked no one; the town says it anyway: closed means someone is still out there."
