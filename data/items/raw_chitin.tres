[gd_resource type="Resource" script_class="MiscDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/misc_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"raw_chitin"
display_name = "Raw Chitin"
description = "A plate of dull gallery-chitin prised from a crawler's back — soft enough to cut with a crew knife, and no kin to the shell the wrights swear by. Crews buy it by the plate for patching; a wright won't touch it."
weight = 1.5
base_value = 10
stackable = true
max_stack = 20
