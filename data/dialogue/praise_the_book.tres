[gd_resource type="Resource" script_class="DialogueTopicDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue_topic_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/dialogue_response.gd" id="2"]

[sub_resource type="Resource" id="resp_suddel_praise"]
script = ExtResource("2")
npc_id = &"suddel"
choice_gated = true
persuade = &"admire"
text = "Square dealing's the whole of the trade. The book doesn't flatter — but it remembers who was fair to it."

[resource]
script = ExtResource("1")
id = &"praise_the_book"
display_name = "square dealing"
lore_sources = Array[StringName]([&"suddel", &"underfirst", &"the_shares"])
responses = Array[ExtResource("2")]([SubResource("resp_suddel_praise")])
