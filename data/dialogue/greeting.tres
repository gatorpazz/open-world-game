[gd_resource type="Resource" script_class="DialogueTopicDef" load_steps=18 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue_topic_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/dialogue_response.gd" id="2"]

[sub_resource type="Resource" id="resp_swift"]
script = ExtResource("2")
npc_id = &"swift"
text = "Another stranger off the covers, and this one still has both boots. If you mean to stay in [[lastdoor]], walk the covered ways and mind the [[scar_hounds]] after the last bell."

[sub_resource type="Resource" id="resp_suddel"]
script = ExtResource("2")
npc_id = &"suddel"
text = "Mind the counter, it's working hours. Two crews out, one due, and [[lastdoor]] wants its manifests moved before the bell — and the [[scar_hounds]] have the road jumpy besides. Say — if a fresh rat pelt crosses you, I could use [[a_small_favor|a small favor]]. Bounty's posted. And the stores counter's open on the bell — beads or goods, we can [[trade]]."

[sub_resource type="Resource" id="resp_kellom"]
script = ExtResource("2")
npc_id = &"kellom"
text = "The wardens' tables could not measure you; my order offers a different answer. I have petitioned to read you into the roll at circuit's end, with the court as witness — it would make you one of us. Ask me of [[tablet_law|the law of the tablets]], and ask for [[the_reading]] when you are ready."

[sub_resource type="Resource" id="resp_ollun"]
script = ExtResource("2")
npc_id = &"ollun"
text = "You've stood in the court, then. Here is what nobody says plainly: the wall lost a tablet, but my rotation still carries its name — I recite a name that is written nowhere. Everyone counts the tablets; nobody counts the voices. The others walk faster past [[the_extra_name|the extra name]]. I don't."

[sub_resource type="Resource" id="resp_torrum_joined"]
script = ExtResource("2")
npc_id = &"torrum"
requires_journal = Array[StringName]([&"joined_the_wardens"])
text = "Warden. The watches are posted and Bryony has your name — walk counted, and mind [[for_the_tallies|the tallies]]."

[sub_resource type="Resource" id="resp_torrum_stood"]
script = ExtResource("2")
npc_id = &"torrum"
requires_journal = Array[StringName]([&"stood_for_the_tallies"])
blocked_by_journal = Array[StringName]([&"joined_the_wardens"])
text = "You stood. The post noticed — the post is built of noticing. [[take_the_cord|Take the cord]], if you'll wear it."

[sub_resource type="Resource" id="resp_torrum"]
script = ExtResource("2")
npc_id = &"torrum"
text = "Captain Torrum. You're the stranger who cost my square its arithmetic — good, saves introductions. We should talk about [[for_the_tallies|the tallies]]."

[sub_resource type="Resource" id="resp_bryony"]
script = ExtResource("2")
npc_id = &"bryony"
text = "Mind the wing-dust — it carries. You're the one the square couldn't read? Then you and my [[the_moth_cages|moths]] have something in common: everyone wants to know what you'd say."

[sub_resource type="Resource" id="resp_wester_joined"]
script = ExtResource("2")
npc_id = &"wester"
requires_journal = Array[StringName]([&"joined_the_licensed_crews"])
text = "Share-mate. Suddel's got the book open and the road's got weather — ask him what's owed, and me [[the_roofed_cache|what's next]]."

[sub_resource type="Resource" id="resp_wester"]
script = ExtResource("2")
npc_id = &"wester"
text = "You'd be the rumor, then. I collect those — profitable habit. Come talk when you like: I've got [[the_roofed_cache|earnest money]] for the one walker the sky won't bill."

[sub_resource type="Resource" id="resp_dossun"]
script = ExtResource("2")
npc_id = &"dossun"
text = "You're the one the square kept — kindly meant, that. This is the gate shrine: [[the_gate_shrine|borrowed names, borrowed patience]]. And the order has [[the_orders_side|an asking]] for you, gentler than most."

[sub_resource type="Resource" id="resp_wren"]
script = ExtResource("2")
npc_id = &"wren"
text = "Mind the needle, love. Come for your legend? Sit — it's told [[the_three_versions|three ways]] this season, and I do all the voices. Just don't ask about [[the_folk_mark|the chalk]]."

[sub_resource type="Resource" id="resp_munnok"]
script = ExtResource("2")
npc_id = &"munnok"
text = "Working. Talk fast. You'll be wanting [[the_three_versions|the counted version]] of what happened to you, I expect — everyone does, once they've heard the sung ones."

[sub_resource type="Resource" id="resp_tansy"]
script = ExtResource("2")
npc_id = &"tansy"
text = "Market row, love — simples strung overhead and drying well. First dose to any who need it, no bead asked. Past that, if you've salvage or beads, look the stall over and we'll [[trade]]."

[sub_resource type="Resource" id="resp_fallback"]
script = ExtResource("2")
text = "Hm. You're new. Guest-portion's whatever's warm, and no one under this roof will let you sit cold. If it's talk you want, [[lastdoor]] has plenty."

[resource]
script = ExtResource("1")
id = &"greeting"
display_name = "Greeting"
responses = Array[ExtResource("2")]([SubResource("resp_swift"), SubResource("resp_suddel"), SubResource("resp_kellom"), SubResource("resp_ollun"), SubResource("resp_torrum_joined"), SubResource("resp_torrum_stood"), SubResource("resp_torrum"), SubResource("resp_bryony"), SubResource("resp_wester_joined"), SubResource("resp_wester"), SubResource("resp_dossun"), SubResource("resp_wren"), SubResource("resp_munnok"), SubResource("resp_tansy"), SubResource("resp_fallback")])
