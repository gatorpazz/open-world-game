[resource]
script = ExtResource("1")
id = &"wester"
display_name = "Wester"
description = "Boss of the Longswathe crew — weathered, wind-named, counting shares aloud. His licensed book sits at Suddel's counter; his offer sits with the one walker the sky won't bill."
