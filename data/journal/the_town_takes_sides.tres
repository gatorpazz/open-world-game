[gd_resource type="Resource" script_class="JournalEntryDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/journal_entry_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"the_town_takes_sides"
lore_sources = Array[StringName]([&"the_untaken_arrival", &"lastdoor"])
text = "I have heard all three of Lastdoor's readings of me now — the wardens' retest, the reciters' reading, the crews' partnership. The town has taken sides about the captain's request, and the sides do not sum."
