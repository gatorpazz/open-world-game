[gd_resource type="Resource" script_class="JournalEntryDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/journal_entry_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"hounds_near_the_covers"
text = "The scar-hounds have been ranging closer to the covers of late. Travelers on the last road have been set upon, and the wardens' patrols are stretched thin."
