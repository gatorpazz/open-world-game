[gd_resource type="Resource" script_class="QuestDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/quest_stage.gd" id="2"]

[sub_resource type="Resource" id="stage_rumor"]
script = ExtResource("2")
journal_entry = &"the_cache_rumor"

[sub_resource type="Resource" id="stage_found"]
script = ExtResource("2")
journal_entry = &"found_the_roofed_cache"

[sub_resource type="Resource" id="stage_joined"]
script = ExtResource("2")
journal_entry = &"joined_the_licensed_crews"
outcome = &"complete"

[resource]
script = ExtResource("1")
id = &"the_roofed_cache"
display_name = "The Roofed Cache"
lore_sources = Array[StringName]([&"licensed_crews", &"wester", &"lastdoor", &"suddel", &"open_fields"])
stages = Array[ExtResource("2")]([SubResource("stage_rumor"), SubResource("stage_found"), SubResource("stage_joined")])
