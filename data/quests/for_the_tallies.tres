stages = Array[ExtResource("2")]([SubResource("stage_woke"), SubResource("stage_request"), SubResource("stage_sides"), SubResource("stage_logs"), SubResource("stage_moth"), SubResource("stage_stood"), SubResource("stage_joined"), SubResource("stage_refused")])
