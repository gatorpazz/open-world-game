[sub_resource type="Resource" id="resp_fallback"]
script = ExtResource("2")
text = "Lean, mud-caked brutes with a grudge against anything on two legs. They've been ranging closer of late — travelers on the causeway have been set upon. Keep something sharp to hand."
journal_entry = &"hounds_in_the_bog"

