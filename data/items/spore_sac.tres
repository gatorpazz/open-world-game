[gd_resource type="Resource" script_class="IngredientDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/ingredient_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"spore_sac"
display_name = "Spore-Sac"
description = "The puffball gland of a gallery spore-puffer, still faintly dusting. Salters and simplers prize it: ground into a draught, its dust is said to thin a worker's regard the way a moth-fall thins a lamp."
weight = 0.1
base_value = 8
stackable = true
max_stack = 20
effects = Array[StringName]([&"hide_regard"])
